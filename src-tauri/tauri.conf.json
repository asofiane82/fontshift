{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fontshift",
  "version": "1.5.1",
  "identifier": "app.fontshift.converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fontshift",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: blob: https://fonts.gstatic.com",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Conversion de polices TTF, OTF, WOFF, WOFF2, EOT et variables",
    "longDescription": "Fontshift convertit vos polices entre TTF, OTF, WOFF, WOFF2 et EOT, conserve ou instancie les axes des polices variables, réduit les jeux de caractères, importe le catalogue Google Fonts et génère le CSS @font-face. Toute la conversion est locale.",
    "copyright": "© 2026 Fontshift",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RkI3MDlDQTQ0RUJFMDMKUldRRHZrNmtuSEQ3cUFTeXZtRlI3SzFjNWVGcmdlMGV5MW82SG8rbzUwbWpqZEZHZDhVRlJESzYK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
