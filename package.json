{
  "name": "fontaine",
  "private": true,
  "version": "1.2.0",
  "description": "Fontaine — conversion de polices (TTF, OTF, WOFF, WOFF2, EOT, variables, Google Fonts)",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "prepare:assets": "node scripts/build-tokens.mjs && node scripts/copy-engine.mjs",
    "dev": "npm run prepare:assets && vite",
    "build": "npm run prepare:assets && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test:engine": "python3 engine/tests/run_engine.py && node engine/tests/pyodide_test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "brotli-wasm": "^3.0.1",
    "intl-messageformat": "^12.2.1",
    "pyodide": "^314.0.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/svelte": "^5.0.9",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "vite": "^6.4.6"
  }
}
